<?xml version="1.0"?>
<package format="2">
  <name>agv_nav_evaluation</name>
  <version>0.1.0</version>
  <description>Independent ROS1 AGV navigation evaluation tools for recording, monitoring, and offline metrics analysis.</description>

  <maintainer email="user@example.com">AGV Evaluation User</maintainer>
  <license>MIT</license>

  <buildtool_depend>catkin</buildtool_depend>

  <depend>rospy</depend>
  <depend>rosbag</depend>
  <depend>roslaunch</depend>
  <depend>std_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>tf2_msgs</depend>
  <depend>actionlib_msgs</depend>
  <depend>diagnostic_msgs</depend>

  <exec_depend>python3-yaml</exec_depend>

  <export/>
</package>
