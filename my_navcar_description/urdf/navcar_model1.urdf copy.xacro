    <gazebo>
      <plugin name="gazebo_ros_control" filename="libgazebo_ros_control.so">
        <publishJointState>false</publishJointState>    <!-- 关闭关节状态 -->
        <publishSimulatedOdometry>false</publishSimulatedOdometry> <!-- 关闭odom -->
        <robotNamespace>/</robotNamespace>
      </plugin>
    </gazebo>
    <gazebo>
	<plugin name="object_controller" filename="libgazebo_ros_planar_move.so">
		<commandTopic>cmd_vel_test</commandTopic>
		<odometryTopic>odom1</odometryTopic>
		<odometryFrame>odom</odometryFrame>
		<publishOdomTF>false</publishOdomTF> 
		<odometryRate>20.0</odometryRate>
		<robotBaseFrame>base_footprint</robotBaseFrame>
	</plugin>
    </gazebo>
    <gazebo reference="imu_link">
  <sensor type="imu" name="imu_sensor">
    <update_rate>100</update_rate> <!-- 更新频率(Hz) -->
    <noise>
      <type>gaussian</type>       <!-- 噪声类型 -->
      <mean>0.0</mean>            <!-- 均值 -->
      <stddev>0.0035</stddev>     <!-- 标准差 -->
    </noise>
    <plugin filename="libgazebo_ros_imu_sensor.so" name="imu_plugin"> <!-- Gazebo插件 -->
      <topicName>/imu</topicName> <!-- ROS话题 -->
      <frameName>imu_link</frameName> <!-- 坐标系 -->
    </plugin>
  </sensor>
</gazebo>
</robot>

