<?xml version="1.0" encoding="utf-8" ?>
<robot name="navcar_model">

    <!-- ========== 根节点：base_footprint ========== -->
    <link name="base_footprint" />

    <!-- ========== base_link ========== -->
    <link name="base_link">
        <inertial>
            <origin xyz="0.0214095781451569 -0.00739192211679758 -0.0758780455724659" rpy="0 0 0" />
            <mass value="232.092213936209" />
            <inertia ixx="12.459666695136" ixy="-8.00048721442858E-05" ixz="-1.19819742203173E-05" iyy="183.546795503744" iyz="-2.90189930668289E-05" izz="194.541899495533" />
        </inertial>
        <visual>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://my_navcar_description/meshes/base_link.STL" />
            </geometry>
            <material name="">
                <color rgba="0.752941176470588 0.752941176470588 0.752941176470588 1" />
            </material>
        </visual>
        <collision>
            <origin xyz="0 0 0" rpy="0 0 0" />
            <geometry>
                <mesh filename="package://my_navcar_description/meshes/base_link.STL" />
            </geometry>
        </collision>
    </link>

    <!-- ========== base_link：车体中心，位于地面投影上方 0.8 m ========== -->
    <joint name="base_footprint_to_base_link" type="fixed">
        <origin xyz="0 0 0.8" rpy="0 0 0" />
        <parent link="base_footprint" />
        <child link="base_link" />
    </joint>

