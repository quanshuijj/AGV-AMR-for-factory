            </geometry>
        </collision>
    </link>

    <!-- ========== Velodyne LiDAR（仿真用） ========== -->
    <xacro:include filename="$(find velodyne_description)/urdf/VLP-16.urdf.xacro" />
    <xacro:VLP-16
      parent="base_link" 
      name="velodyne" 
      gpu="false"
      hz="10"
      samples="440"
      lasers="16"
      min_angle="-3.14159" max_angle="3.14159"
      min_range="0.4" max_range="100.0"
      topic="/velodyne_points"
      organize_cloud="true">            
     <origin xyz="1.955 0 0.05" rpy="0 0 0" /> <!-- 修正：与实际安装位置一致 -->
   </xacro:VLP-16>

