<?xml version="1.0"?>
<launch>
  <!-- 系统配置参数 -->
  <arg name="use_gnss" default="true"/>
  <arg name="debug_mode" default="false"/>
  <arg name="record_data" default="false"/>
  <!-- ========================================= -->
  <!-- 多传感器融合节点 -->
  <!-- ========================================= -->
  
  <!-- 全局EKF: 融合所有传感器数据 -->
  <!--输出: map->base_link的最优估计-->
  <node pkg="robot_localization" type="ekf_localization_node" name="ekf_global" output="screen">
    <rosparam command="load" file="$(find my_nav_assist)/config/ekf_global_config.yaml"/>
    
    <!-- 输入数据重映射 -->
    <remap from="laser_odometry" to="/laser_odometry"/>  <!-- 激光里程计 -->
    <remap from="odom1" to="/gnss_odometry"/>             <!-- GNSS里程计 -->
    <remap from="imu0" to="/chcnav_fix_demo/myimu" />  <!--/chcnav_fix_demo/myimu"/> -->                   <!-- IMU数据 -->
    
    <!-- 输出数据 -->
    <remap from="odometry/filtered" to="/global_odometry"/><!-- 融合后的全局定位 -->
    
    <!-- 坐标系参数 -->
    <param name="map_frame" value="map"/>                 <!-- 全局坐标系 -->
    <param name="odom_frame" value="odom"/>               <!-- 局部坐标系 -->
    <param name="base_link_frame" value="base_footprint"/>     <!-- 机器人坐标系 -->
    <param name="world_frame" value="map"/>               <!-- 工作坐标系(全局) -->
    
    <!-- 调试参数 -->
    <param name="print_diagnostics" value="$(arg debug_mode)"/>
  </node>
  
</launch>
