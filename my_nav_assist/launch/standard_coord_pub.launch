<?xml version="1.0"?>
<launch>
   <!-- 坐标修正节点 -->
   <node pkg="my_nav_assist" type="tf_coordinate_converter" 
      name="standard_coordinate_fix" output="screen">
     <remap from="global_odometry" to="global_odometry"/>
     <remap from="local_odometry" to="/odometry/filtered"/>
     
     <param name="map_frame" value="map"/>
     <param name="odom_frame" value="odom"/>
     <param name="base_link_frame" value="base_footprint"/>
     <param name="publish_frequency" value="50.0"/>
     <param name="publish_tf" value="true"/>
     <param name="publish_pose" value="false"/>
   </node>
</launch>
