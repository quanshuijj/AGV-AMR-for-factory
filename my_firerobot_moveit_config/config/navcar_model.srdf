<?xml version="1.0" encoding="UTF-8"?>
<!--This does not replace URDF, and is not an extension of URDF.
    This is a format for representing semantic information about the robot structure.
    A URDF file must exist for this robot as well, where the joints and the links that are referenced are defined
-->
<robot name="navcar_model">
    <!--DISABLE COLLISIONS: By default it is assumed that any link of the robot could potentially come into collision with any other link in the robot. This tag disables collision checking between a specified pair of links. -->
    <disable_collisions link1="base_link" link2="cam_f_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="cam_l_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="cam_r_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="cam_rear_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="l_f_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="l_r_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="lidar_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="r_f_link" reason="Adjacent"/>
    <disable_collisions link1="base_link" link2="r_r_link" reason="Adjacent"/>
    <disable_collisions link1="cam_f_link" link2="cam_l_link" reason="Never"/>
    <disable_collisions link1="cam_f_link" link2="cam_r_link" reason="Never"/>
    <disable_collisions link1="cam_f_link" link2="cam_rear_link" reason="Never"/>
    <disable_collisions link1="cam_f_link" link2="l_f_link" reason="Never"/>
    <disable_collisions link1="cam_f_link" link2="l_r_link" reason="Never"/>
    <disable_collisions link1="cam_f_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="cam_f_link" link2="r_f_link" reason="Never"/>
    <disable_collisions link1="cam_f_link" link2="r_r_link" reason="Never"/>
    <disable_collisions link1="cam_l_link" link2="cam_r_link" reason="Never"/>
    <disable_collisions link1="cam_l_link" link2="cam_rear_link" reason="Never"/>
    <disable_collisions link1="cam_l_link" link2="l_f_link" reason="Never"/>
    <disable_collisions link1="cam_l_link" link2="l_r_link" reason="Never"/>
    <disable_collisions link1="cam_l_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="cam_l_link" link2="r_f_link" reason="Never"/>
    <disable_collisions link1="cam_l_link" link2="r_r_link" reason="Never"/>
    <disable_collisions link1="cam_r_link" link2="cam_rear_link" reason="Never"/>
    <disable_collisions link1="cam_r_link" link2="l_f_link" reason="Never"/>
    <disable_collisions link1="cam_r_link" link2="l_r_link" reason="Never"/>
    <disable_collisions link1="cam_r_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="cam_r_link" link2="r_f_link" reason="Never"/>
    <disable_collisions link1="cam_r_link" link2="r_r_link" reason="Never"/>
    <disable_collisions link1="cam_rear_link" link2="l_f_link" reason="Never"/>
    <disable_collisions link1="cam_rear_link" link2="l_r_link" reason="Never"/>
    <disable_collisions link1="cam_rear_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="cam_rear_link" link2="r_f_link" reason="Never"/>
    <disable_collisions link1="cam_rear_link" link2="r_r_link" reason="Never"/>
    <disable_collisions link1="l_f_link" link2="l_r_link" reason="Never"/>
    <disable_collisions link1="l_f_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="l_f_link" link2="r_f_link" reason="Never"/>
    <disable_collisions link1="l_f_link" link2="r_r_link" reason="Never"/>
    <disable_collisions link1="l_r_link" link2="lidar_link" reason="Never"/>
    <disable_collisions link1="l_r_link" link2="r_f_link" reason="Never"/>
    <disable_collisions link1="l_r_link" link2="r_r_link" reason="Never"/>
    <disable_collisions link1="lidar_link" link2="r_f_link" reason="Never"/>
    <disable_collisions link1="lidar_link" link2="r_r_link" reason="Never"/>
    <disable_collisions link1="r_f_link" link2="r_r_link" reason="Never"/>
</robot>
